{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sigrun",
  "identifier": "com.sigrun.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sigrun",
        "width": 1100,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0b1020"
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "publisher": "mojoaar",
    "homepage": "https://johansen.foo",
    "copyright": "Copyright © 2026 mojoaar",
    "shortDescription": "SSH connections and keys in a local encrypted vault, served to ssh through a built-in agent.",
    "longDescription": "Sigrun keeps your SSH connections and private keys in a local encrypted vault. A built-in agent serves them to ssh, so no private key file has to sit on disk. Everything stays on your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
